{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eHomeLabs/Ocean2MQTT/produits/schema.json",
  "title": "Fiche produit Ocean2MQTT",
  "description": "Une fiche décrit un produit EnOcean de la bibliothèque. Un fichier par produit : produits/<marque>/<référence>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "marque", "nom", "type", "eep", "appairage", "support"],
  "properties": {
    "ref": {"type": "string", "minLength": 2, "description": "Référence commerciale principale"},
    "marque": {"type": "string", "minLength": 2},
    "nom": {"$ref": "#/$defs/textes", "description": "Nom affiché, par langue (fr obligatoire)"},
    "type": {"enum": ["actionneur", "prise", "interrupteur", "capteur", "chauffage"]},
    "eep": {"$ref": "#/$defs/eep"},
    "eep_supplementaires": {
      "type": "array",
      "items": {"$ref": "#/$defs/eep"},
      "description": "Autres profils émis par le même produit (ex. CO2 + COV)"
    },
    "decodeur": {
      "type": "string",
      "description": "Décodeur particulier quand l'EEP ne suffit pas (ex. soft_remote, single_button)"
    },
    "fabricant_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2047,
      "description": "Code fabricant EnOcean (11 bits), pour la suggestion automatique"
    },
    "appairage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "etapes"],
      "properties": {
        "mode": {"enum": ["ute_bidir", "ute_uni", "1bs", "4bs", "rps"]},
        "etapes": {
          "type": "object",
          "required": ["fr"],
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2}$": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
          }
        },
        "apres": {"$ref": "#/$defs/textes", "description": "Conseil affiché une fois l'appairage réussi"}
      }
    },
    "canaux": {"type": "integer", "minimum": 1, "maximum": 8, "default": 1},
    "mesure": {"type": "boolean", "default": false, "description": "Mesure de puissance / énergie"},
    "reglages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "led", "power_on_state", "local_control", "taught_in", "power_failure",
          "auto_off", "delay_off", "switch_type", "roller_shutter",
          "temperature_offset", "humidity_offset", "timeout", "buttons"
        ]
      }
    },
    "recom": {"type": "boolean", "default": false, "description": "Remote Commissioning (ReMan / ReCom) géré"},
    "support": {"enum": ["valide", "communaute"]},
    "notice": {"type": "string", "pattern": "^https://"},
    "photo": {"type": "string", "pattern": "^[a-z0-9._-]+\\.(png|jpg|webp)$"},
    "variantes": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string", "description": "Remarques pour les contributeurs (non affichées)"}
  },
  "$defs": {
    "eep": {"type": "string", "pattern": "^[0-9A-F]{2}-[0-9A-F]{2}-[0-9A-F]{2}$"},
    "textes": {
      "type": "object",
      "required": ["fr"],
      "additionalProperties": false,
      "patternProperties": {"^[a-z]{2}$": {"type": "string", "minLength": 2}}
    }
  }
}
